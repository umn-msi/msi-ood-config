<%-
  slurm_args = ["--nodes", "-1", "--ntasks-per-node", "4"]
-%>

---
batch_connect:
  template: vnc
  script_wrapper: |
    module purge
    export PATH="/opt/TurboVNC/bin:$PATH"
    export WEBSOCKIFY_CMD="/usr/local/bin/websockify"
    %s
  set_host: "host=$(hostname -f)"
script:
  accounting_id: "<%= account %>"
  wall_time: "<%= num_hours.to_i * 60 * 60 %>"
  native:
    <%- slurm_args.each do |arg| %>
    - "<%= arg %>"
    <%- end %>
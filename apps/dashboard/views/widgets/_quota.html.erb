<%

user = Etc.getpwuid(Process.uid).name
gids = Process.groups + [Process.gid]
groups = gids.uniq.map { |g| Etc.getgrgid(g).name }


def emit_usage(label, usage, limit)

  # avoid Infinity exceptions
  return "" if limit.nil? || limit == 0

  usage_percent = (usage.to_f / limit * 100).to_i

  usage_bgtype = if usage_percent > 90
    "bg-danger"
  elsif usage_percent > 75
    "bg-warning"
  else
    "bg-success"
  end

  title = if label == 'Data'
    "#{number_to_human_size(usage)} / #{number_to_human_size(limit)}"
  else
    "#{number_with_delimiter(usage)} / #{number_with_delimiter(limit)}"
  end

  return <<-HTML

  <div class="quota-row w-100" title="#{title}">
    <span class="quota-label"><span class="tree">└─</span> #{label}</span>
    <span class="progress quota-bar">
      <div class="progress-bar progress-bar-striped #{usage_bgtype}"
           role="progressbar"
           style="width: #{usage_percent}%;"
           aria-valuenow="#{usage_percent}"
           aria-valuemin="0"
           aria-valuemax="100"></div>
    </span>
    <span class="quota-pct">#{usage_percent}%</span>
  </div>


  HTML


end
-%>


<% user_quotas = JSON.parse(File.read("/common/hpc/bake-quota/user/#{user}.json")) %>

<div class="card system-and-shared-apps-header">
  <div class="card-header">
    Quota Usage
  </div>
  <div class="list-group list-group-flush">


    <span class="list-group-item d-flex align-items-center mb-0 header">
      <label class="flex-grow-1 mb-0 fw-semibold text-dark">Home Directory</label>
    </span>

    <span class="list-group-item d-flex flex-column align-items-center mb-0 header" style="background-color: white;">
      <% homedir = user_quotas['vast']['/msicore/users'] %>
      <%= emit_usage('Data', homedir['used_capacity'], homedir['hard_limit']).html_safe %>
      <%= emit_usage('Files', homedir['used_inodes'], homedir['hard_limit_inodes']).html_safe %>
    </span>

<% 
if user_quotas['tier2'] != nil
%>
    <span class="list-group-item d-flex align-items-center mb-0 header">
      <label class="flex-grow-1 mb-0 fw-semibold text-dark">Personal Tier 2</label>
    </span>

    <span class="list-group-item d-flex flex-column align-items-center mb-0 header" style="background-color: white;">
      <%= emit_usage('Data', user_quotas['tier2']['size_kb'], user_quotas['tier2']['max_size_kb']).html_safe %>
    </span>
<%
end
%>

<% 

groups.each do |group|
  group_file = "/common/hpc/bake-quota/group/#{group}.json"
  next unless File.readable?(group_file)

  group_quotas = JSON.parse(File.read(group_file))
  next unless group_quotas['vast'].select { |k, v| v['hard_limit'].to_i > 0 || v['hard_limit_inodes'].to_i > 0 }.count > 0
  
%>
    <span class="list-group-item d-flex align-items-center mb-0 header">
      <label class="flex-grow-1 mb-0 fw-semibold text-dark">
        <%= group %>
      </label>
      <a href="https://mymsi.msi.umn.edu/project/<%= group %>/storage" target="_blank" class="ms-auto text-decoration-none" style="font-size: 0.6rem;">
        MyMSI Dashboard↗
      </a>
    </span>
<%
  if (standard = group_quotas['vast'].fetch('/msicore/projects/standard', nil))
%>
    <span class="list-group-item d-flex flex-column align-items-start mb-0 header" style="background-color: white;">
      <label class="mb-2 fw-bold">Project</label>
      <%= emit_usage('Data', standard['used_capacity'], standard['hard_limit']).html_safe %>
      <%= emit_usage('Files', standard['used_inodes'], standard['hard_limit_inodes']).html_safe %>
    </span>
<% 
  end

  if (scratch = group_quotas['vast'].fetch('/msicore/scratch', nil))
%>
    <span class="list-group-item d-flex flex-column align-items-start mb-0 header" style="background-color: white;">
      <label class="mb-2 fw-bold">Scratch</label>
      <%= emit_usage('Data', scratch['used_capacity'], scratch['hard_limit']).html_safe %>
      <%= emit_usage('Files', scratch['used_inodes'], scratch['hard_limit_inodes']).html_safe %>
    </span>
<%
  end
end 
%>

  </div>
</div>
